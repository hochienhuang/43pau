rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Any student can read and auto-upload their test submissions
    match /testSubmissions/{submissionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Any student can read and auto-upload their leaderboard score upon test completion
    match /leaderboard/{nickname} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
